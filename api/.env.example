# Backend only. Copy to api\.env and never commit real values.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-6-luna
AZURE_SEARCH_ENDPOINT=https://YOUR-SERVICE.search.windows.net
AZURE_SEARCH_API_KEY=replace-me
AZURE_SEARCH_INDEX=rag-1795508603194
AZURE_SEARCH_API_VERSION=2026-08-01-preview
ENABLE_WEB_SEARCH=true
CHAT_ENABLED=true
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com

# Exact origins, not URL prefixes. Add the deployed HTTPS UI origin later.
ALLOWED_ORIGINS=http://localhost:3201,http://127.0.0.1:3201

# Analytics (Azure Table Storage). Falls back to AzureWebJobsStorage; analytics is skipped if neither is set.
# ANALYTICS_STORAGE_CONNECTION_STRING=
# Optional secret salt mixed into the hashed userId stored in analytics tables. Changing it re-keys every user.
# ANALYTICS_HASH_SALT=
