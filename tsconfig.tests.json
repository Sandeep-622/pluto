{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "plugins": [],
    "incremental": false,
    "paths": {
      "@/*": ["./src/*"],
      "@api/*": ["./api/src/*"],
      "@azure/functions": ["./api/node_modules/@azure/functions"],
      "google-auth-library": ["./api/node_modules/google-auth-library"]
    }
  },
  "include": ["tests/**/*.ts", "vitest.config.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "api/node_modules", "api/dist", "api/.test-host"]
}
