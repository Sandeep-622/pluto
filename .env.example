# Server only. Copy to .env; never prefix secrets with NEXT_PUBLIC_.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-6-luna

AZURE_SEARCH_ENDPOINT=https://YOUR-SERVICE.search.windows.net
AZURE_SEARCH_API_KEY=replace-me
AZURE_SEARCH_INDEX=rag-1795508603194
AZURE_SEARCH_API_VERSION=2026-08-01-preview

# Optional ingestion credentials; the chat application does not read Storage.
AZURE_STORAGE_ACCOUNT_NAME=plutostorageaccount0
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONNECTION_STRING=

# Server capability switch. The user's Include web toggle always starts off.
ENABLE_WEB_SEARCH=true
CHAT_ENABLED=true
