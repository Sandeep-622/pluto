{
  "name": "pluto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {   "node": ">=24 <25" },
  "scripts": {
    "dev": "node scripts/local.mjs dev",
    "build": "node scripts/build-frontend.mjs",
    "build:api": "npm --prefix api run build",
    "start": "node scripts/local.mjs preview",
    "start:frontend": "serve out --listen tcp://127.0.0.1:3201 --no-clipboard",
    "start:api": "npm --prefix api start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit && npm --prefix api run typecheck && tsc --project tsconfig.tests.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:host": "node scripts/test-host.mjs",
    "test:artifacts": "node scripts/check-artifacts.mjs",
    "test:azure": "npm --prefix api run test:azure"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "serve": "14.2.8",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.3",
    "vitest": "5.1.0"
  }
}
